<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The app's own UI (your ported pocketWeb design), privileged bridge -->
    <WebView
        android:id="@+id/appWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sandboxed viewer for untrusted on-chain sites; shown only while browsing a site -->
    <WebView
        android:id="@+id/siteWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Native pairing banner overlay (pairing is a native concern) -->
    <TextView
        android:id="@+id/pairingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        android:padding="10dp"
        android:background="#F2FF9800"
        android:textColor="#000000"
        android:text="Not enabled in Minima Core. Tap to open Minima Core → Apps and enable PocketWeb (enable to browse; grant Admin to publish)."
        android:textSize="12sp" />

</FrameLayout>
